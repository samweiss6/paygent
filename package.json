{
  "name": "paygent",
  "version": "0.1.0",
  "description": "Self-hosted MCP server that lets an AI agent pay with policy-limited, single-use virtual cards funded from a non-custodial wallet. Test mode only.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=24.0.0" },
  "bin": { "paygent": "bin/paygent.js" },
  "scripts": {
    "start": "node bin/paygent.js start",
    "setup": "node bin/paygent.js setup",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
